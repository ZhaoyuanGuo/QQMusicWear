<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- QPlay/DLNA 渲染器：SSDP 组播发现 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:name=".QMusicApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.QMusic">

        <!-- 独立手表应用：不依赖配对手机侧 App -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />
        <uses-library
            android:name="wear-sdk"
            android:required="false" />

        <!-- 主界面：本身不再声明 LAUNCHER，改由下方 activity-alias 按音乐源切换桌面名/图标 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:launchMode="singleTask" />

        <!-- 各音乐源的桌面入口别名：名称/图标不同，运行时只启用当前源对应的一个 -->
        <activity-alias
            android:name=".MainActivityQq"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="@string/app_name_qq"
            android:icon="@mipmap/ic_launcher_qq"
            android:roundIcon="@mipmap/ic_launcher_qq">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityKugou"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name_kugou"
            android:icon="@mipmap/ic_launcher_kugou"
            android:roundIcon="@mipmap/ic_launcher_kugou">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityNetease"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name_netease"
            android:icon="@mipmap/ic_launcher_netease"
            android:roundIcon="@mipmap/ic_launcher_netease">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityFanqie"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name_fanqie"
            android:icon="@mipmap/ic_launcher_fanqie"
            android:roundIcon="@mipmap/ic_launcher_fanqie">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".data.player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 「正在播放」磁贴 -->
        <service
            android:name=".data.tile.PlayingTileService"
            android:exported="true"
            android:label="@string/tile_playing">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_SERVICE" />
            </intent-filter>
        </service>

        <!-- 「正在播放」表盘 Complication 数据源（SHORT_TEXT） -->
        <service
            android:name=".data.tile.PlayingComplicationService"
            android:exported="true"
            android:label="@string/complication_label">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>
    </application>

</manifest>
